#!/usr/bin/env bash
set -Eeuo pipefail

APPDIR="${APPDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
SOURCE_DIR="$APPDIR/usr/lib/turbodecky"
BACKEND="$SOURCE_DIR/InstallTD.sh"

show_info() {
  local text="$1"
  printf -v text '%b' "$text"
  if command -v yad >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    yad --info --title="Turbo Decky" --width=620 --text="$text" 2>/dev/null || true
  elif command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    zenity --info --title="Turbo Decky" --width=620 --text="$text" 2>/dev/null || true
  elif command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    kdialog --title "Turbo Decky" --msgbox "$text" 2>/dev/null || true
  else
    printf '\n%s\n' "$text"
  fi
}

show_error() {
  local text="$1"
  printf -v text '%b' "$text"
  if command -v yad >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    yad --error --title="Turbo Decky" --width=680 --text="$text" 2>/dev/null || true
  elif command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    zenity --error --title="Turbo Decky" --width=680 --text="$text" 2>/dev/null || true
  elif command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    kdialog --title "Turbo Decky" --error "$text" 2>/dev/null || true
  else
    printf '\nERRO: %s\n' "$text" >&2
  fi
}

confirm_action() {
  local text="$1" answer
  if command -v yad >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    yad --question --title="Turbo Decky" --width=620 --text="$text" 2>/dev/null
  elif command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    zenity --question --title="Turbo Decky" --width=620 --text="$text" 2>/dev/null
  elif command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    kdialog --title "Turbo Decky" --yesno "$text" 2>/dev/null
  else
    read -r -p "$text [s/N]: " answer
    [[ "$answer" =~ ^[sSyY]$ ]]
  fi
}

confirm_exact_s() {
  local text="$1" answer prompt
  prompt="$text"$'\n\nDigite exatamente s para continuar:'
  if command -v yad >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    answer="$(yad --entry --title="Turbo Decky" --width=700 \
      --text="$prompt" --entry-text="" 2>/dev/null)" || return 1
  elif command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    answer="$(zenity --entry --title="Turbo Decky" --width=700 \
      --text="$prompt" --entry-text="" 2>/dev/null)" || return 1
  elif command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    answer="$(kdialog --title "Turbo Decky" --inputbox "$prompt" "" 2>/dev/null)" || return 1
  else
    read -r -p "$prompt " answer
  fi
  [[ "$answer" == "s" ]]
}

PROGRESS_ACTIVE=0
PROGRESS_PID=""
PROGRESS_FD=""
PROGRESS_DBUS_REF=""
PROGRESS_DBUS_TOOL=""
declare -a PROGRESS_DBUS_ARGS=()
PROGRESS_MODE="terminal"
PROGRESS_CURRENT=0
ACTION_FIFO_DIR=""

progress_qdbus() {
  local command
  for command in qdbus qdbus-qt5 qdbus6; do
    if command -v "$command" >/dev/null 2>&1; then
      command -v "$command"
      return 0
    fi
  done
  return 1
}

progress_start() {
  local title="$1"
  PROGRESS_ACTIVE=1
  PROGRESS_CURRENT=0
  PROGRESS_MODE="terminal"
  PROGRESS_DBUS_REF=""
  PROGRESS_DBUS_TOOL=""
  PROGRESS_DBUS_ARGS=()
  if command -v yad >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    coproc TURBODECKY_LAUNCHER_PROGRESS {
      yad --progress --title="Turbo Decky" --width=700 --height=180 \
        --percentage=0 --auto-close --no-buttons --text="$title" >/dev/null 2>&1
    }
    PROGRESS_PID="$TURBODECKY_LAUNCHER_PROGRESS_PID"
    PROGRESS_FD="${TURBODECKY_LAUNCHER_PROGRESS[1]}"
    PROGRESS_MODE="pipe"
  elif command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    coproc TURBODECKY_LAUNCHER_PROGRESS {
      zenity --progress --title="Turbo Decky" --width=700 --height=180 \
        --percentage=0 --auto-close --no-cancel --text="$title" >/dev/null 2>&1
    }
    PROGRESS_PID="$TURBODECKY_LAUNCHER_PROGRESS_PID"
    PROGRESS_FD="${TURBODECKY_LAUNCHER_PROGRESS[1]}"
    PROGRESS_MODE="pipe"
  elif command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    PROGRESS_DBUS_TOOL="$(progress_qdbus 2>/dev/null || true)"
    if [[ -n "$PROGRESS_DBUS_TOOL" ]]; then
      PROGRESS_DBUS_REF="$(kdialog --progressbar "$title" 100 2>/dev/null || true)"
      if [[ -n "$PROGRESS_DBUS_REF" ]]; then
        read -r -a PROGRESS_DBUS_ARGS <<< "$PROGRESS_DBUS_REF"
        PROGRESS_MODE="kdialog"
      else
        PROGRESS_DBUS_TOOL=""
      fi
    fi
    [[ "$PROGRESS_MODE" == kdialog ]] || printf '\n%s\n' "$title" >&2
  else
    printf '\n%s\n' "$title" >&2
  fi
}

progress_update() {
  local percent="$1" message="$2"
  [[ "${PROGRESS_ACTIVE:-0}" == 1 ]] || return 0
  PROGRESS_CURRENT="$percent"
  if [[ -n "${PROGRESS_FD:-}" ]]; then
    printf '%s\n#%s\n' "$percent" "$message" >&"$PROGRESS_FD" 2>/dev/null || true
  elif [[ -n "${PROGRESS_DBUS_REF:-}" && -n "${PROGRESS_DBUS_TOOL:-}" ]]; then
    "$PROGRESS_DBUS_TOOL" "${PROGRESS_DBUS_ARGS[@]}" setLabelText "$message" >/dev/null 2>&1 || true
    "$PROGRESS_DBUS_TOOL" "${PROGRESS_DBUS_ARGS[@]}" Set "" value "$percent" >/dev/null 2>&1 || true
  else
    printf '\r[%3d%%] %s' "$percent" "$message" >&2
  fi
}

progress_close() {
  [[ "${PROGRESS_ACTIVE:-0}" == 1 ]] || return 0
  local was_terminal=0
  [[ "$PROGRESS_MODE" == terminal ]] && was_terminal=1
  if [[ -n "${PROGRESS_FD:-}" ]]; then
    eval "exec ${PROGRESS_FD}>&-" 2>/dev/null || true
    PROGRESS_FD=""
  fi
  if [[ -n "${PROGRESS_DBUS_REF:-}" && -n "${PROGRESS_DBUS_TOOL:-}" ]]; then
    "$PROGRESS_DBUS_TOOL" "${PROGRESS_DBUS_ARGS[@]}" close >/dev/null 2>&1 || true
    PROGRESS_DBUS_REF=""
    PROGRESS_DBUS_TOOL=""
    PROGRESS_DBUS_ARGS=()
  fi
  if [[ -n "${PROGRESS_PID:-}" ]]; then
    kill "$PROGRESS_PID" 2>/dev/null || true
    wait "$PROGRESS_PID" 2>/dev/null || true
    PROGRESS_PID=""
  fi
  (( was_terminal == 1 )) && printf '\n' >&2
  PROGRESS_ACTIVE=0
  PROGRESS_CURRENT=0
  PROGRESS_MODE="terminal"
}

select_action() {
  if command -v yad >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    yad --list --title="Turbo Decky" --width=820 --height=540 \
      --text="Selecione uma ação. As operações administrativas solicitarão autenticação." \
      --column="Ação" --column="Descrição" --print-column=1 --hide-column=1 \
      apply-zram "Aplicar perfil Charcoal com ZRAM padrão" \
      apply-zswap "Aplicar perfil Charcoal com ZSWAP" \
      status "Exibir diagnóstico dos parâmetros efetivos" \
      setup-lavd "Instalar ou ativar SCX LAVD" \
      revert "Reverter alterações gerenciadas pelo Turbo Decky" \
      exit "Sair" 2>/dev/null || printf 'exit\n'
  elif command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    zenity --list --title="Turbo Decky" --width=820 --height=540 \
      --text="Selecione uma ação. As operações administrativas solicitarão autenticação." \
      --column="Ação" --column="Descrição" --print-column=1 --hide-column=1 \
      apply-zram "Aplicar perfil Charcoal com ZRAM padrão" \
      apply-zswap "Aplicar perfil Charcoal com ZSWAP" \
      status "Exibir diagnóstico dos parâmetros efetivos" \
      setup-lavd "Instalar ou ativar SCX LAVD" \
      revert "Reverter alterações gerenciadas pelo Turbo Decky" \
      exit "Sair" 2>/dev/null || printf 'exit\n'
  elif command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    kdialog --title "Turbo Decky" --menu "Selecione uma ação" \
      apply-zram "Perfil Charcoal com ZRAM" \
      apply-zswap "Perfil Charcoal com ZSWAP" \
      status "Diagnóstico" \
      setup-lavd "Ativar SCX LAVD" \
      revert "Reverter alterações" \
      exit "Sair" 2>/dev/null || printf 'exit\n'
  else
    cat <<'MENU'
1) Aplicar perfil Charcoal com ZRAM padrão
2) Aplicar perfil Charcoal com ZSWAP
3) Exibir diagnóstico
4) Instalar ou ativar SCX LAVD
5) Reverter alterações
6) Sair
MENU
    local answer
    read -r -p "Opção: " answer
    case "$answer" in
      1) printf '%s\n' apply-zram ;;
      2) printf '%s\n' apply-zswap ;;
      3) printf '%s\n' status ;;
      4) printf '%s\n' setup-lavd ;;
      5) printf '%s\n' revert ;;
      *) printf 'exit\n' ;;
    esac
  fi
}

stage_payload() {
  STAGED_DIR="$(mktemp -d /tmp/turbodecky-appimage.XXXXXX)"
  install -d -m 0755 "$STAGED_DIR/lib"
  install -m 0755 "$BACKEND" "$STAGED_DIR/InstallTD.sh"
  cp -a "$SOURCE_DIR/lib/." "$STAGED_DIR/lib/"
  find "$STAGED_DIR/lib" -type d -exec chmod 0755 {} +
  find "$STAGED_DIR/lib" -type f -exec chmod 0644 {} +
}

cleanup() {
  progress_close
  [[ -z "${ACTION_FIFO_DIR:-}" ]] || rm -rf -- "$ACTION_FIFO_DIR"
  [[ -z "${STAGED_DIR:-}" ]] || rm -rf -- "$STAGED_DIR"
  [[ -z "${ACTION_LOG:-}" ]] || rm -f -- "$ACTION_LOG"
}
trap cleanup EXIT INT TERM

run_unprivileged() {
  # Status/version are captured by the launcher so the launcher can present a
  # single dialog. Force the backend to emit text instead of opening a second
  # graphical dialog inside the command substitution.
  TURBODECKY_UI=terminal /usr/bin/bash "$BACKEND" "$@"
}

run_privileged() {
  local action="$1" status=0
  local child_pid line output_fifo failure_message=""
  stage_payload
  ACTION_LOG="$(mktemp /tmp/turbodecky-action.XXXXXX.log)"
  ACTION_FIFO_DIR="$(mktemp -d /tmp/turbodecky-output.XXXXXX)"
  output_fifo="$ACTION_FIFO_DIR/events"
  mkfifo "$output_fifo"
  progress_start "Aguardando autorização administrativa para: $action"
  progress_update 3 "Aguardando autorização administrativa"

  if (( EUID == 0 )); then
    TURBODECKY_UI=terminal TURBODECKY_ASSUME_YES=1 \
      TURBODECKY_PROGRESS_PROTOCOL=1 \
      /usr/bin/bash "$STAGED_DIR/InstallTD.sh" "$action" >"$output_fifo" 2>&1 &
    child_pid=$!
  elif command -v pkexec >/dev/null 2>&1; then
    local pkexec_bin
    pkexec_bin="$(command -v pkexec)"
    "$pkexec_bin" /usr/bin/env \
      TURBODECKY_UI=terminal TURBODECKY_ASSUME_YES=1 \
      TURBODECKY_PROGRESS_PROTOCOL=1 \
      /usr/bin/bash "$STAGED_DIR/InstallTD.sh" "$action" >"$output_fifo" 2>&1 &
    child_pid=$!
  elif command -v kdesu >/dev/null 2>&1; then
    local command_line
    printf -v command_line '%q ' /usr/bin/env TURBODECKY_UI=terminal \
      TURBODECKY_ASSUME_YES=1 TURBODECKY_PROGRESS_PROTOCOL=1 \
      /usr/bin/bash "$STAGED_DIR/InstallTD.sh" "$action"
    kdesu -c "$command_line" >"$output_fifo" 2>&1 &
    child_pid=$!
  elif command -v sudo >/dev/null 2>&1 && [[ -t 0 ]]; then
    sudo /usr/bin/env TURBODECKY_UI=terminal TURBODECKY_ASSUME_YES=1 \
      TURBODECKY_PROGRESS_PROTOCOL=1 \
      /usr/bin/bash "$STAGED_DIR/InstallTD.sh" "$action" >"$output_fifo" 2>&1 &
    child_pid=$!
  else
    rm -f -- "$output_fifo"
    show_error "Nenhum agente de autenticação compatível foi encontrado. Instale ou habilite pkexec/polkit e execute novamente."
    progress_close
    return 1
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == $'TURBODECKY_PROGRESS\t'* ]]; then
      IFS=$'\t' read -r _ percent message <<< "$line"
      progress_update "${percent:-0}" "${message:-Processando...}"
    else
      if [[ "$line" == ERRO:* ]]; then
        failure_message="$line"
      fi
      printf '%s\n' "$line" >> "$ACTION_LOG"
    fi
  done < "$output_fifo"
  wait "$child_pid" || status=$?
  rm -rf -- "$ACTION_FIFO_DIR"
  ACTION_FIFO_DIR=""
  if (( status == 0 )); then
    progress_update 100 "Operação concluída"
  else
    progress_update "${PROGRESS_CURRENT:-0}" \
      "${failure_message:-Falha na operação (código $status)}"
  fi
  progress_close

  local summary
  summary="$(tail -n 30 "$ACTION_LOG" 2>/dev/null || true)"
  if (( status == 0 )); then
    show_info "Operação concluída.\n\n${summary:-Sem mensagens adicionais.}"
  else
    if [[ -n "$failure_message" ]]; then
      show_error "A operação falhou com código $status.\n\n$failure_message\n\n${summary:-Consulte /var/log/turbodecky.log.}"
    else
      show_error "A operação falhou com código $status.\n\n${summary:-Consulte /var/log/turbodecky.log.}"
    fi
  fi
  return "$status"
}

confirmation_text() {
  case "$1" in
    --apply-zram) printf '%s' "Aplicar o perfil Charcoal com ZRAM padrão? O sistema solicitará autenticação e poderá exigir reinicialização." ;;
    --apply-zswap) printf '%s' "Aplicar o perfil Charcoal com ZSWAP? Pode ser criado um swapfile de 8 GiB e será necessária reinicialização." ;;
    --setup-lavd) printf '%s' "Instalar e ativar SCX LAVD pelo gerenciador de pacotes?" ;;
    --revert) printf '%s' "Reverter as alterações gerenciadas pelo Turbo Decky usando os snapshots existentes?" ;;
    *) printf '%s' "Executar esta operação administrativa?" ;;
  esac
}

run_action() {
  local action="$1" backend_action
  case "$action" in
    version|--version)
      run_unprivileged --version
      ;;
    help|--help|-h)
      run_unprivileged --help
      ;;
    status|--status)
      local output
      output="$(run_unprivileged --status 2>&1)" || {
        show_error "$output"
        return 1
      }
      show_info "$output"
      ;;
    apply-zram|--apply-zram) backend_action=--apply-zram ;;
    apply-zswap|--apply-zswap) backend_action=--apply-zswap ;;
    setup-lavd|--setup-lavd) backend_action=--setup-lavd ;;
    revert|--revert) backend_action=--revert ;;
    *)
      show_error "Ação inválida: $action"
      return 2
      ;;
  esac

  if [[ -n "${backend_action:-}" ]]; then
    confirm_action "$(confirmation_text "$backend_action")" || return 0
    run_privileged "$backend_action"
  fi
}

[[ -r "$BACKEND" ]] || {
  show_error "O pacote está incompleto: InstallTD.sh não foi encontrado."
  exit 1
}

if (($# > 0)); then
  run_action "$1"
  exit $?
fi

while :; do
  action="$(select_action)"
  [[ "$action" != exit ]] || exit 0
  run_action "$action" || true
done
